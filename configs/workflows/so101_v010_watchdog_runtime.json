{
  "schema_version": "farpoint.so101-watchdog-policy.v1",
  "recent_window_attempts": 50,
  "minimum_recent_attempts": 50,
  "recent_failure_fraction": null,
  "minimum_recent_success_rate": 0.2,
  "consecutive_failure_limit": 12,
  "distinct_variations_for_consecutive_failure": true,
  "no_success_timeout_seconds": 7200,
  "minimum_free_disk_bytes": 536870912000,
  "stale_run_state_seconds": 60,
  "stale_manifest_seconds": 60,
  "structural_failure_classes": [
    "runner_error",
    "contact_force_limit",
    "bilateral_contact_lost",
    "collision",
    "object_dropped",
    "phase_timeout"
  ]
}
