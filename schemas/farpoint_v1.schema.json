{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farpoint.local/schema/farpoint.dataset.v1.json",
  "title": "Farpoint Dataset V1 Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "format", "format_version", "split", "task", "robot", "simulation", "recording"],
  "properties": {
    "schema_version": {"const": "farpoint.dataset.v1"},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "format": {"const": "lerobot"},
    "format_version": {"const": "v3"},
    "split": {"enum": ["train", "validation", "test"]},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "instruction"],
      "properties": {"name": {"type": "string", "minLength": 1}, "instruction": {"type": "string", "minLength": 1}}
    },
    "robot": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "gripper", "arm_dof", "gripper_dof"],
      "properties": {"name": {"const": "ur10e"}, "gripper": {"const": "robotiq_2f85"}, "arm_dof": {"const": 6}, "gripper_dof": {"const": 1}}
    },
    "simulation": {
      "type": "object", "additionalProperties": false,
      "required": ["simulator", "image", "physics", "control_mode"],
      "properties": {"simulator": {"const": "Isaac Sim"}, "image": {"type": "string", "minLength": 1}, "physics": {"const": "PhysX"}, "control_mode": {"const": "articulation_drive"}}
    },
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["fps", "cameras", "image_width", "image_height"],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "cameras": {"type": "array", "minItems": 1, "contains": {"const": "observation.images.front"}, "items": {"type": "string", "pattern": "^observation\\.images\\.[a-z0-9_.-]+$"}},
        "image_width": {"type": "integer", "minimum": 1},
        "image_height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
