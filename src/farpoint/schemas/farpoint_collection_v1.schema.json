{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xuwenyihust/farpoint/src/farpoint/schemas/farpoint_collection_v1.schema.json",
  "title": "Farpoint Balanced Collection Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "collection_id", "task_id", "git_commit", "policy_id",
    "policy_sha256", "position_plan_sha256", "config_sha256",
    "simulator_image_digest", "simulator_payload_sha256", "execution_status",
    "quality_status", "attempts", "acceptance"
  ],
  "properties": {
    "schema_version": {"const": "farpoint.collection.v1"},
    "collection_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "position_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "simulator_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "simulator_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_status": {"enum": ["FINISHED", "ABORTED"]},
    "quality_status": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
    "failure_reason": {"type": ["string", "null"]},
    "release_policy": {"const": "coverage_first_all_successful"},
    "release_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted", "required_cells", "observed_covered_cells",
        "minimum_successes_per_cell", "successes_per_cell",
        "eligible_episodes", "split_counts"
      ],
      "properties": {
        "accepted": {"type": "boolean"},
        "required_cells": {"type": "integer", "minimum": 1},
        "observed_covered_cells": {"type": "integer", "minimum": 0},
        "minimum_successes_per_cell": {"type": "integer", "minimum": 1},
        "successes_per_cell": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "eligible_episodes": {"type": "integer", "minimum": 0},
        "split_counts": {"$ref": "#/$defs/splits"}
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id", "episode_id", "variation_id", "cell_id", "slot", "seed",
          "object_position_xy_m",
          "source_split", "origin", "source_run_id", "source_git_commit",
          "outcome_success", "dataset_valid", "selected_for_dataset"
        ],
        "properties": {
          "attempt_id": {"type": "string", "minLength": 1},
          "trial_id": {"type": "string", "minLength": 1},
          "episode_id": {"type": "string", "minLength": 1},
          "variation_id": {"type": "string", "minLength": 1},
          "cell_id": {"type": "string", "pattern": "^r[0-9]{2}_c[0-9]{2}$"},
          "slot": {"type": "integer", "minimum": 0, "maximum": 2},
          "seed": {"type": "integer", "minimum": 0},
          "object_position_xy_m": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "number"}
          },
          "source_split": {"enum": ["train", "validation", "test"]},
          "dataset_split": {"enum": ["train", "validation", "test"]},
          "selection_rank": {"type": "integer", "minimum": 1, "maximum": 2},
          "origin": {"enum": ["imported", "new"]},
          "imported_from_collection_id": {"type": "string", "minLength": 1},
          "recovery_retry": {"type": "boolean"},
          "retry_index": {"type": "integer", "minimum": 1},
          "source_run_id": {"type": "string", "minLength": 1},
          "source_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "outcome_success": {"type": "boolean"},
          "dataset_valid": {"type": "boolean"},
          "selected_for_dataset": {"type": "boolean"},
          "failure_category": {"type": ["string", "null"]},
          "failure_reason": {"type": ["string", "null"]}
        },
        "allOf": [
          {
            "if": {"properties": {"selected_for_dataset": {"const": true}}},
            "then": {"required": ["dataset_split", "selection_rank"]}
          }
        ]
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted", "required_task_yield", "observed_task_yield",
        "maximum_task_attempts", "observed_task_attempts", "observed_task_successes",
        "required_selected_episodes", "observed_selected_episodes",
        "required_cells", "observed_covered_cells", "required_selected_per_cell",
        "selected_per_cell", "required_splits", "observed_splits"
      ],
      "properties": {
        "accepted": {"type": "boolean"},
        "required_task_yield": {"type": "number", "minimum": 0, "maximum": 1},
        "observed_task_yield": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_task_attempts": {"type": "integer", "minimum": 1},
        "observed_task_attempts": {"type": "integer", "minimum": 0},
        "observed_task_successes": {"type": "integer", "minimum": 0},
        "required_selected_episodes": {"type": "integer", "minimum": 1},
        "observed_selected_episodes": {"type": "integer", "minimum": 0},
        "required_cells": {"type": "integer", "minimum": 1},
        "observed_covered_cells": {"type": "integer", "minimum": 0},
        "required_selected_per_cell": {"type": "integer", "minimum": 1},
        "selected_per_cell": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "required_splits": {"$ref": "#/$defs/splits"},
        "observed_splits": {"$ref": "#/$defs/splits"}
      }
    }
  },
  "dependentRequired": {
    "release_policy": ["release_acceptance"],
    "release_acceptance": ["release_policy"]
  },
  "$defs": {
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      }
    }
  }
}
