{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xuwenyihust/farpoint/src/farpoint/schemas/farpoint_dataset_v2.schema.json",
  "title": "Farpoint Dataset Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "format",
    "format_version",
    "demonstration_policy",
    "splits",
    "tasks",
    "robot",
    "simulation",
    "recording",
    "contracts"
  ],
  "properties": {
    "schema_version": {"const": "farpoint.dataset.v2"},
    "dataset_id": {"type": "string", "minLength": 1},
    "format": {"const": "lerobot"},
    "format_version": {"const": "v3"},
    "demonstration_policy": {"const": "successful_only"},
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "gripper", "arm_dof", "gripper_dof"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "gripper": {"type": "string", "minLength": 1},
        "arm_dof": {"type": "integer", "minimum": 1},
        "gripper_dof": {"type": "integer", "minimum": 1}
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["simulator", "image", "image_digest", "physics"],
      "properties": {
        "simulator": {"type": "string", "minLength": 1},
        "image": {"type": "string", "minLength": 1},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "physics": {"type": "string", "minLength": 1}
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "cameras", "image_width", "image_height", "state_features", "action_features"],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "cameras": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "image_width": {"type": "integer", "minimum": 1},
        "image_height": {"type": "integer", "minimum": 1},
        "state_features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "action_features": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode", "variation"],
      "properties": {
        "episode": {"const": "farpoint.episode.v2"},
        "variation": {"const": "farpoint.variation.v2"},
        "benchmark": {"const": "farpoint.benchmark.v2"},
        "collection": {"const": "farpoint.collection.v1"}
      },
      "oneOf": [
        {"required": ["benchmark"], "not": {"required": ["collection"]}},
        {"required": ["collection"], "not": {"required": ["benchmark"]}}
      ]
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "instruction", "object_shape", "success_criteria_id"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "object_shape": {"type": "string", "minLength": 1},
        "success_criteria_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
