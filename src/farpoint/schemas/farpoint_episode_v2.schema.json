{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xuwenyihust/farpoint/src/farpoint/schemas/farpoint_episode_v2.schema.json",
  "title": "Farpoint Episode Metadata Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "provenance", "task", "embodiment", "scene", "variation", "recording", "outcome"],
  "properties": {
    "schema_version": {"const": "farpoint.episode.v2"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_id", "trial_id", "task_id", "split", "dataset_episode_index"],
      "properties": {
        "episode_id": {"type": "string", "minLength": 1},
        "trial_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "validation", "test"]},
        "dataset_episode_index": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_commit", "config_sha256", "simulator", "physics_engine", "simulator_image", "simulator_image_digest", "robot_asset_id", "robot_asset_path", "episode_seed", "derived_seed"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "simulator": {"type": "string", "minLength": 1},
        "physics_engine": {"type": "string", "minLength": 1},
        "simulator_image": {"type": "string", "minLength": 1},
        "simulator_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "robot_asset_id": {"type": "string", "minLength": 1},
        "robot_asset_path": {"type": "string", "minLength": 1},
        "episode_seed": {"type": "integer", "minimum": 0},
        "derived_seed": {"type": "integer", "minimum": 0}
      }
    },
    "task": {"$ref": "#/$defs/task"},
    "embodiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robot", "gripper", "arm_dof", "gripper_dof", "controller", "control_mode", "grasp_mode"],
      "properties": {
        "robot": {"type": "string", "minLength": 1},
        "gripper": {"type": "string", "minLength": 1},
        "arm_dof": {"type": "integer", "minimum": 1},
        "gripper_dof": {"type": "integer", "minimum": 1},
        "controller": {"type": "string", "minLength": 1},
        "control_mode": {"type": "string", "minLength": 1},
        "grasp_mode": {"type": "string", "minLength": 1}
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_frame", "object", "target", "camera", "lighting_profile_id", "appearance_profile_id"],
      "properties": {
        "coordinate_frame": {"type": "string", "minLength": 1},
        "object": {"$ref": "#/$defs/object"},
        "target": {"$ref": "#/$defs/target"},
        "camera": {"$ref": "#/$defs/camera"},
        "lighting_profile_id": {"type": "string", "minLength": 1},
        "appearance_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "variation": {"$ref": "#/$defs/variation"},
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fps", "cameras", "image_width", "image_height", "frame_count"],
      "properties": {
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "cameras": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "image_width": {"type": "integer", "minimum": 1},
        "image_height": {"type": "integer", "minimum": 1},
        "frame_count": {"type": "integer", "minimum": 1}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["success", "dataset_valid", "failure_category", "failure_reason", "quality"],
      "properties": {
        "success": {"type": "boolean"},
        "dataset_valid": {"type": "boolean"},
        "failure_category": {
          "enum": [null, "infrastructure", "perception", "motion_planning", "grasp", "pickup", "transport", "release", "placement", "settling", "evaluation"]
        },
        "failure_reason": {"type": ["string", "null"]},
        "quality": {"$ref": "#/$defs/quality"}
      }
    }
  },
  "$defs": {
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "quaternion": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_m", "orientation_xyzw", "yaw_degrees", "coordinate_frame"],
      "properties": {
        "position_m": {"$ref": "#/$defs/vector3"},
        "orientation_xyzw": {"$ref": "#/$defs/quaternion"},
        "yaw_degrees": {"type": "number"},
        "coordinate_frame": {"type": "string", "minLength": 1}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "instruction", "object_shape", "success_criteria_id"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "object_shape": {"type": "string", "minLength": 1},
        "success_criteria_id": {"type": "string", "minLength": 1}
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "dimensions_m", "mass_kg", "material_id", "initial_pose"],
      "properties": {
        "shape": {"type": "string", "minLength": 1},
        "dimensions_m": {"$ref": "#/$defs/vector3"},
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "material_id": {"type": "string", "minLength": 1},
        "initial_pose": {"$ref": "#/$defs/pose"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "pose"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "pose": {"$ref": "#/$defs/pose"}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "calibration_id", "intrinsics", "extrinsics"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "calibration_id": {"type": "string", "minLength": 1},
        "intrinsics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fx", "fy", "cx", "cy"],
          "properties": {
            "fx": {"type": "number", "exclusiveMinimum": 0},
            "fy": {"type": "number", "exclusiveMinimum": 0},
            "cx": {"type": "number"},
            "cy": {"type": "number"}
          }
        },
        "extrinsics": {"$ref": "#/$defs/pose"}
      }
    },
    "variationValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_position_m", "object_yaw_degrees", "object_shape", "object_dimensions_m", "appearance_profile_id", "camera_profile_id", "lighting_profile_id"],
      "properties": {
        "object_position_m": {"$ref": "#/$defs/vector3"},
        "object_yaw_degrees": {"type": "number"},
        "object_shape": {"type": "string", "minLength": 1},
        "object_dimensions_m": {"$ref": "#/$defs/vector3"},
        "appearance_profile_id": {"type": "string", "minLength": 1},
        "camera_profile_id": {"type": "string", "minLength": 1},
        "lighting_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "variation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "variation_id", "varied_axes", "frozen_axes", "cell_id", "slot", "requested", "resolved"],
      "properties": {
        "schema_version": {"const": "farpoint.variation.v2"},
        "variation_id": {"type": "string", "minLength": 1},
        "varied_axes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "frozen_axes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cell_id": {"type": "string", "minLength": 1},
        "slot": {"type": "integer", "minimum": 0},
        "split": {"enum": ["train", "validation", "test"]},
        "requested": {"$ref": "#/$defs/variationValues"},
        "resolved": {"$ref": "#/$defs/variationValues"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_xy_error_m", "perception_error_m", "bilateral_contact_frames", "lift_height_m", "settling_error", "joint_smoothness_score"],
      "properties": {
        "final_xy_error_m": {"type": ["number", "null"]},
        "perception_error_m": {"type": ["number", "null"]},
        "bilateral_contact_frames": {"type": ["integer", "null"], "minimum": 0},
        "lift_height_m": {"type": ["number", "null"]},
        "settling_error": {"type": ["number", "null"]},
        "joint_smoothness_score": {"type": ["number", "null"]}
      }
    }
  }
}
