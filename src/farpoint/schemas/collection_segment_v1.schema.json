{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farpoint Collection Segment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "campaign_sha256", "segment_id", "segment_index", "git_commit", "plan_sha256", "parent_manifest_sha256", "oracle_profile_allowlist", "execution_status", "quality_status", "attempts", "segment_sha256"],
  "properties": {
    "schema_version": {"const": "farpoint.collection-segment.v1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"$ref": "#/$defs/sha256"},
    "segment_id": {"type": "string", "minLength": 1},
    "segment_index": {"type": "integer", "minimum": 0},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "parent_manifest_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
    "oracle_profile_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "execution_status": {"enum": ["RUNNING", "FINISHED", "ABORTED", "PAUSED"]},
    "quality_status": {"enum": ["NOT_EVALUATED", "PASS", "FAIL"]},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "segment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
