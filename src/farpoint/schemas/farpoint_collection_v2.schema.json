{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farpoint Coverage Collection v2",
  "type": "object",
  "required": ["schema_version", "collection_id", "display_name", "task_id", "object_shape", "git_commit", "policy_id", "policy_sha256", "position_plan_sha256", "config_sha256", "simulator_image_digest", "simulator_payload_sha256", "execution_status", "quality_status", "attempts", "acceptance"],
  "properties": {
    "schema_version": {"const": "farpoint.collection.v2"},
    "collection_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "object_shape": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "position_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "simulator_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "simulator_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_status": {"enum": ["FINISHED", "ABORTED"]},
    "quality_status": {"enum": ["PASS", "FAIL", "NOT_EVALUATED"]},
    "failure_reason": {"type": ["string", "null"]},
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trial_id", "episode_id", "variation_id", "cell_id", "slot", "seed", "object_position_xy_m", "source_split", "source_run_id", "source_git_commit", "outcome_success", "dataset_valid", "selected_for_dataset"],
        "properties": {
          "trial_id": {"type": "string"}, "episode_id": {"type": "string"}, "variation_id": {"type": "string"},
          "cell_id": {"type": "string", "pattern": "^r[0-9]{2}_c[0-9]{2}$"},
          "slot": {"type": "integer", "minimum": 0, "maximum": 5}, "seed": {"type": "integer", "minimum": 0},
          "object_position_xy_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "source_split": {"enum": ["train", "validation", "test"]}, "dataset_split": {"enum": ["train", "validation", "test"]},
          "selection_rank": {"const": 1}, "source_run_id": {"type": "string"},
          "source_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "outcome_success": {"type": "boolean"}, "dataset_valid": {"type": "boolean"}, "selected_for_dataset": {"type": "boolean"},
          "failure_category": {"type": ["string", "null"]}, "failure_reason": {"type": ["string", "null"]}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "required": ["accepted", "observed_task_yield", "maximum_task_attempts", "observed_task_attempts", "observed_task_successes", "required_selected_episodes", "observed_selected_episodes", "required_cells", "observed_covered_cells", "required_selected_per_cell", "selected_per_cell", "required_splits", "observed_splits"]
    }
  }
}
