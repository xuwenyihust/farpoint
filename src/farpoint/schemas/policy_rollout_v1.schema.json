{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farpoint.dev/schemas/policy_rollout_v1.schema.json",
  "title": "Farpoint policy rollout contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "task", "checkpoint", "environment", "control", "acceptance", "scenes"],
  "properties": {
    "schema_version": {"const": "farpoint.policy-rollout.v1"},
    "suite_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "instruction", "evaluation_class"],
      "properties": {
        "task_id": {"const": "so101_cube_pick_place"},
        "instruction": {"type": "string", "minLength": 1},
        "evaluation_class": {"enum": ["interface_smoke", "independent_holdout_smoke", "independent_holdout", "recovery_expert_replay"]}
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_type", "training_run_id", "training_git_commit", "training_image_id", "step", "model_sha256", "dataset"],
      "properties": {
        "policy_type": {"const": "act"},
        "training_run_id": {"type": "string", "minLength": 1},
        "training_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "training_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "step": {"type": "integer", "minimum": 1},
        "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset": {
          "type": "object", "additionalProperties": false,
          "required": ["repo_id", "revision", "resolved_commit", "train_episodes", "validation_episodes"],
          "properties": {
            "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
            "revision": {"type": "string", "minLength": 1},
            "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "train_episodes": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
            "validation_episodes": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"},
            "excluded_test_episodes": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
          }
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["gym_id", "isaac_lab_ref", "isaac_sim_version", "isaac_base_image_id", "lerobot_version", "camera_features"],
      "properties": {
        "gym_id": {"const": "Farpoint-SO101-PickPlace-Cube-v0"},
        "isaac_lab_ref": {"const": "release/3.0.0-beta2"},
        "isaac_sim_version": {"const": "6.0.0"},
        "isaac_base_image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "lerobot_version": {"const": "0.4.4"},
        "camera_features": {
          "oneOf": [
            {"const": ["observation.images.front"]},
            {"const": ["observation.images.front", "observation.images.wrist"]}
          ]
        },
        "camera_profile_id": {"type": "string", "minLength": 1}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["physics_hz", "policy_hz", "max_policy_steps", "stable_steps"],
      "oneOf": [
        {"required": ["max_delta_calibrated"], "not": {"required": ["action_safety_profile"]}},
        {"required": ["action_safety_profile"], "not": {"required": ["max_delta_calibrated"]}}
      ],
      "properties": {
        "physics_hz": {"const": 120},
        "policy_hz": {"const": 30},
        "max_policy_steps": {"type": "integer", "minimum": 1},
        "replan_interval_steps": {"type": "integer", "minimum": 1},
        "max_delta_calibrated": {"type": "number", "exclusiveMinimum": 0},
        "action_safety_profile": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "profile_id", "joint_order", "source"],
          "oneOf": [
            {"required": ["arm_max_command_speed_deg_s", "gripper_max_command_slew_calibrated_per_step"]},
            {"required": ["max_command_slew_calibrated_per_step"]}
          ],
          "properties": {
            "schema_version": {"const": "farpoint.action-safety-profile.v1"},
            "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
            "joint_order": {
              "const": ["shoulder_pan.pos", "shoulder_lift.pos", "elbow_flex.pos", "wrist_flex.pos", "wrist_roll.pos", "gripper.pos"]
            },
            "arm_max_command_speed_deg_s": {"type": "number", "exclusiveMinimum": 0},
            "gripper_max_command_slew_calibrated_per_step": {"type": "number", "exclusiveMinimum": 0},
            "max_command_slew_calibrated_per_step": {
              "type": "array", "minItems": 6, "maxItems": 6,
              "items": {"type": "number", "exclusiveMinimum": 0}
            },
            "source": {
              "type": "object", "additionalProperties": false,
              "required": ["kind", "reference", "resolved_revision", "statistic"],
              "properties": {
                "kind": {"enum": ["open_source_hardware_default", "dataset_percentile"]},
                "reference": {"type": "string", "minLength": 1},
                "resolved_revision": {"type": "string", "minLength": 1},
                "statistic": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "stable_steps": {"type": "integer", "minimum": 1}
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["required_completed_episodes", "minimum_task_successes", "maximum_nonfinite_actions", "maximum_hard_range_violations"],
      "properties": {
        "required_completed_episodes": {"type": "integer", "minimum": 1},
        "minimum_task_successes": {"type": "integer", "minimum": 0},
        "maximum_nonfinite_actions": {"type": "integer", "minimum": 0},
        "maximum_hard_range_violations": {"type": "integer", "minimum": 0},
        "maximum_hard_range_excess_calibrated": {"type": "number", "minimum": 0},
        "maximum_delta_limited_actions": {"type": "integer", "minimum": 0}
      }
    },
    "recovery_replay_source": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "selection_sha256", "evaluated_episode_count", "state_restore", "action_safety_calibration"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evaluated_episode_count": {"type": "integer", "minimum": 1},
        "state_restore": {"const": "handoff_snapshot_v1"},
        "action_safety_calibration": {
          "type": "object", "additionalProperties": false,
          "required": ["reference_suite_id", "reference_report_sha256", "reference_minimum_delta_limited_actions_per_episode", "reference_maximum_delta_limited_actions_per_episode", "allowed_maximum_delta_limited_actions_per_episode"],
          "properties": {
            "reference_suite_id": {"type": "string", "minLength": 1},
            "reference_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "reference_minimum_delta_limited_actions_per_episode": {"type": "integer", "minimum": 0},
            "reference_maximum_delta_limited_actions_per_episode": {"type": "integer", "minimum": 0},
            "allowed_maximum_delta_limited_actions_per_episode": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "holdout_source": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "campaign_sha256", "plan_sha256", "scene_count", "evaluated_scene_count", "disjoint", "segment_count"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scene_count": {"const": 20},
        "evaluated_scene_count": {"type": "integer", "minimum": 1, "maximum": 20},
        "disjoint": {"const": true},
        "segment_count": {"type": "integer", "minimum": 1}
      }
    },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scene_id", "seed", "object"],
        "properties": {
          "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
          "seed": {"type": "integer", "minimum": 0},
          "object_variant_id": {"type": "string", "minLength": 1},
          "region_band": {"enum": ["core", "middle", "outer"]},
          "yaw_stratum_id": {"type": "string", "minLength": 1},
          "yaw_degrees": {"type": "number", "minimum": 0, "exclusiveMaximum": 90},
          "object": {
            "type": "object", "additionalProperties": false,
            "required": ["shape", "dimensions_m", "position_m", "orientation_xyzw", "rgba", "mass_kg"],
            "properties": {
              "shape": {"const": "cube"},
              "dimensions_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}},
              "position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "orientation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
              "rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
              "mass_kg": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "initial_state": {
            "type": "object", "additionalProperties": false,
            "required": ["snapshot_sha256", "policy_step", "joint_positions_rad", "joint_velocities_rad_s", "joint_position_target_rad", "object_pose_xyzw", "object_linear_velocity_mps", "object_angular_velocity_rad_s", "contact_forces_n", "applied_policy_action_calibrated"],
            "properties": {
              "snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "policy_step": {"type": "integer", "minimum": 0},
              "joint_positions_rad": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
              "joint_velocities_rad_s": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
              "joint_position_target_rad": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}},
              "object_pose_xyzw": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "number"}},
              "object_linear_velocity_mps": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "object_angular_velocity_rad_s": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "contact_forces_n": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
              "applied_policy_action_calibrated": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}
            }
          }
        }
      }
    }
  }
}
