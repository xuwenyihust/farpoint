{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://farpoint.dev/schemas/policy_training_v1.schema.json",
  "title": "Farpoint policy training contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "dataset", "environment", "policy", "training", "smoke"],
  "properties": {
    "schema_version": {"const": "farpoint.policy-training.v1"},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_id", "revision", "codebase_version", "splits", "expected", "video_backend", "required_features"],
      "properties": {
        "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "revision": {"type": "string", "minLength": 1},
        "resolved_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["hub", "local_snapshot"]},
            "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "local_snapshot"}}},
              "then": {"required": ["tree_sha256"]},
              "else": {"not": {"required": ["tree_sha256"]}}
            }
          ]
        },
        "codebase_version": {"const": "v3.0"},
        "splits": {
          "type": "object", "minProperties": 2,
          "required": ["train", "validation"],
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
        },
        "metadata_splits": {
          "type": "object", "minProperties": 2,
          "required": ["train", "validation"],
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
        },
        "expected": {
          "type": "object", "additionalProperties": false,
          "required": ["total_episodes", "total_frames", "fps", "selected_frames"],
          "properties": {
            "total_episodes": {"type": "integer", "minimum": 1},
            "total_frames": {"type": "integer", "minimum": 1},
            "fps": {"type": "integer", "minimum": 1},
            "selected_frames": {
              "type": "object", "minProperties": 2,
              "required": ["train", "validation"],
              "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
              "additionalProperties": {"type": "integer", "minimum": 1}
            }
          }
        },
        "video_backend": {"const": "pyav"},
        "required_features": {
          "type": "object", "minProperties": 3,
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["dtype", "shape"],
            "properties": {
              "dtype": {"type": "string"},
              "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"not": {"required": ["source"]}},
              {"properties": {"source": {"properties": {"kind": {"const": "hub"}}}}}
            ]
          },
          "then": {"required": ["resolved_commit"]},
          "else": {"not": {"required": ["resolved_commit"]}}
        }
      ]
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["lerobot_version", "requires_cuda", "architecture"],
      "properties": {
        "lerobot_version": {"const": "0.4.4"},
        "requires_cuda": {"const": true},
        "architecture": {"const": "aarch64"}
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "device"],
      "properties": {
        "type": {"const": "act"},
        "device": {"const": "cuda"},
        "vision_backbone": {"type": "string", "minLength": 1},
        "pretrained_backbone_weights": {"type": "string", "minLength": 1},
        "chunk_size": {"type": "integer", "minimum": 1},
        "n_action_steps": {"type": "integer", "minimum": 1}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "episode_slices", "expected_episode_count", "expected_frame_count"],
      "properties": {
        "kind": {"enum": ["uniform_frames", "deterministic_grouped_batches"]},
        "episode_slices": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
        },
        "expected_episode_count": {"type": "integer", "minimum": 1},
        "expected_frame_count": {"type": "integer", "minimum": 1},
        "groups": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["group_id", "episode_slices"],
            "properties": {
              "group_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
              "episode_slices": {
                "type": "array", "minItems": 1,
                "items": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
              }
            }
          }
        },
        "batch_cycle": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "minProperties": 1,
            "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]+$"},
            "additionalProperties": {"type": "integer", "minimum": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "deterministic_grouped_batches"}}},
          "then": {"required": ["groups", "batch_cycle"]}
        }
      ]
    },
    "training": {"$ref": "#/$defs/run"},
    "pilot": {"$ref": "#/$defs/run"},
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["split", "sample_count", "batch_size", "num_workers", "seed", "minimum_relative_improvement"],
      "properties": {
        "profile": {"enum": ["pilot", "training"]},
        "split": {"const": "validation"},
        "sample_count": {"type": "integer", "minimum": 2},
        "batch_size": {"type": "integer", "minimum": 1},
        "num_workers": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0},
        "minimum_relative_improvement": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
      }
    },
    "smoke": {"$ref": "#/$defs/run"}
  },
  "$defs": {
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "batch_size", "steps", "num_workers", "save_checkpoint", "push_to_hub", "wandb_enable", "log_freq"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0},
        "batch_size": {"type": "integer", "minimum": 1},
        "steps": {"type": "integer", "minimum": 1},
        "num_workers": {"type": "integer", "minimum": 0},
        "save_checkpoint": {"type": "boolean"},
        "save_freq": {"type": "integer", "minimum": 1},
        "push_to_hub": {"const": false},
        "wandb_enable": {"type": "boolean"},
        "log_freq": {"type": "integer", "minimum": 1}
      }
    }
  }
}
